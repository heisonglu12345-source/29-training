# 危險操作：直接擋下
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "禁止遞迴強制刪除",
)
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "禁止強制推送，需要時請人工操作",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "此操作會遺失尚未提交的變更",
)
prefix_rule(
    pattern = ["dotnet", "user-secrets"],
    decision = "forbidden",
    justification = "禁止 agent 讀取或修改 .NET user-secrets；請由使用者在外部終端機管理",
    match = [
        "dotnet user-secrets list --project src/OrderHub.Web",
        "dotnet user-secrets set Gemini:ApiKey placeholder --project src/OrderHub.Web",
    ],
    not_match = ["dotnet build src/OrderHub.Web"],
)

# 重大操作：必須由使用者確認
prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "重置資料庫前必須取得使用者確認",
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "推送遠端前必須取得使用者確認",
)

# 日常操作：直接允許
prefix_rule(pattern = ["dotnet", "build"], decision = "allow", justification = "日常建置")
prefix_rule(pattern = ["dotnet", "test"], decision = "allow", justification = "日常測試")
prefix_rule(pattern = ["dotnet", "run"], decision = "allow", justification = "啟動本機網站")
prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "唯讀 Git 狀態")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "唯讀差異檢查")
prefix_rule(pattern = ["git", "log"], decision = "allow", justification = "唯讀歷史查詢")
prefix_rule(pattern = ["git", "add"], decision = "allow", justification = "日常提交流程")
prefix_rule(pattern = ["git", "commit"], decision = "allow", justification = "日常提交流程")
